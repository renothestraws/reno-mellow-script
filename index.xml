    <reapack name="ReNo Mellow - MIDI cleaner.lua" type="script" desc="ReNo Mellow - MIDI cleaner">
      <metadata>
        <description><![CDATA[{\rtf1\ansi\deff0{\fonttbl{\f0 \fswiss Helvetica;}}\f0\fs20 Nettoie les items MIDI s\u233?lectionn\u233?s : supprime les SysEx, les Program Change, le pitch bend et tous les CC sauf CC4 (foot controller), CC11 (expression) et CC64 (sustain) ; passe tous les \u233?v\u233?nements restants sur le canal MIDI 1 ; r\u232?gle le timebase de l'item sur "Beats (position, length, rate)".}]]></description>
        <link rel="website" href="https://github.com/renothestraws/reno-mellow-script">GitHub</link>
      </metadata>
      <version name="1.1" author="ReNo Mellow" time="2026-11-16T16:49:40Z">
        <changelog><![CDATA[Suppression des messages SysEx]]></changelog>
        <source main="main">https://raw.githubusercontent.com/renothestraws/reno-mellow-script/main/MIDI/ReNo%20Mellow%20-%20MIDI%20cleaner.lua</source>
      </version>
    </reapack>
